#!/usr/bin/env python3
"""Desktop reminder for KorTrainer: asks the local server whether today's study is done and,
if not, shows a notification with an "Открыть" button that opens the trainer.

Run by the kortrainer-reminder.timer systemd user unit. Silent when the server is not running.
Environment: KORTRAINER_URL (default http://localhost:8080).
"""
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

URL = os.environ.get("KORTRAINER_URL", "http://localhost:8080").rstrip("/")
NOTIFICATION_TIMEOUT_MS = 10 * 60 * 1000


def main() -> int:
    try:
        with urllib.request.urlopen(f"{URL}/api/reminder", timeout=10) as response:
            reminder = json.load(response)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return 0  # trainer not running: nothing to remind about

    if not reminder.get("shouldRemind"):
        return 0

    command = [
        "notify-send",
        "--app-name=KorTrainer",
        "--icon=accessories-dictionary",
        f"--expire-time={NOTIFICATION_TIMEOUT_MS}",
        "--action=open=Открыть тренажёр",
        "--wait",
        reminder.get("title", "KorTrainer"),
        reminder.get("message", ""),
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=NOTIFICATION_TIMEOUT_MS / 1000 + 30)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return 0

    if result.stdout.strip() == "open":
        subprocess.Popen(["xdg-open", URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
