@* Optional speaking: say a line, see how much of it the recognizer heard and where it differs. *@
@using KorTrainer.Domain.Hangul
@inject ISpeechInput SpeechInput

<div class="speak-check">
    @if (_comparison is { } c)
    {
        <div class="diff-result @(Passed(c) ? "passed" : "failed")">
            <p class="verdict">@(Passed(c) ? (c.IsExact ? "Точно!" : "Почти, засчитано") : "Есть отличия") · @((int)Math.Round(c.Score * 100))%</p>
            <p class="diff" lang="ko">
                @foreach (var part in c.Parts)
                {
                    @if (part.Kind == DiffKind.Match)
                    {
                        <span>@part.Text</span>
                    }
                    else if (part.Kind == DiffKind.Missing)
                    {
                        <mark class="diff-missing" title="Пропущено или услышано иначе">@part.Text</mark>
                    }
                    else
                    {
                        <del class="diff-extra" title="Лишнее">@part.Text</del>
                    }
                }
            </p>
            <p class="muted small">Распознано: <span lang="ko">@_heard</span></p>
        </div>
    }

    <button type="button" class="btn small" disabled="@_listening" @onclick="ListenAsync">
        @(_listening ? "🎙 Говорите…" : _comparison is null ? "🎙 Проговорить" : "🎙 Ещё раз")
    </button>

    @if (_error is not null)
    {
        <p class="notice warning small">@_error</p>
    }
</div>

@code {
    private const double PassScore = 0.8;

    private bool _listening;
    private string? _heard;
    private string? _error;
    private SentenceComparison? _comparison;

    [Parameter, EditorRequired]
    public string Expected { get; set; } = string.Empty;

    private static bool Passed(SentenceComparison comparison) => comparison.Score >= PassScore;

    private async Task ListenAsync()
    {
        _listening = true;
        _error = null;
        StateHasChanged();
        try
        {
            var result = await SpeechInput.ListenAsync();
            if (result.Text is null)
            {
                _error = result.Error ?? "Ничего не услышано. Попробуйте ещё раз.";
                return;
            }

            _heard = result.Text;
            _comparison = SentenceComparer.Compare(Expected, result.Text);
        }
        finally
        {
            _listening = false;
        }
    }
}
