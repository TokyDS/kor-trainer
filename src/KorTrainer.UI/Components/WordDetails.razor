@* Memory aids for a word: hanja roots, example sentences and the learner's own note. *@
@inject IKorTrainerApi Api

@if (_details is { } d)
{
    <div class="word-details">
        @if (d.HardReason is not null)
        {
            <p class="hard-badge" title="Это слово часто забывается">Трудное слово: @d.HardReason</p>
        }

        @if (d.Roots.Count > 0)
        {
            <div class="roots" aria-label="Корни ханча">
                <span class="muted small">Корни@(d.Hanja is not null ? $" · {d.Hanja}" : string.Empty)</span>
                <div class="root-chips">
                    @foreach (var root in d.Roots)
                    {
                        <a class="root-chip" href="/hanja/@Uri.EscapeDataString(root.Character)" title="Все слова с этим корнем">
                            <span class="root-char" lang="zh">@root.Character</span>
                            <span lang="ko">@root.Syllable</span>
                            <span class="root-gloss">@(root.Russian ?? "—")</span>
                            @if (root.FamilySize > 1)
                            {
                                <small class="muted">@root.FamilySize сл.</small>
                            }
                        </a>
                    }
                </div>
            </div>
        }

        @if (d.Examples.Count > 0)
        {
            <ul class="examples" aria-label="Примеры">
                @foreach (var example in d.Examples)
                {
                    <li>
                        <span class="example-ko" lang="ko">@example.Korean</span>
                        <SpeakButton Text="@example.Korean" ShowKeyHint="false" />
                        <span class="example-ru">@example.Russian@(example.MachineTranslated ? " *" : string.Empty)</span>
                    </li>
                }
            </ul>
            @if (d.Examples.Any(e => e.MachineTranslated))
            {
                <p class="muted tiny">Примеры — Tatoeba (CC BY 2.0 FR); * машинный перевод.</p>
            }
        }

        @if (ShowNote)
        {
            <form class="note-form" @onsubmit="SaveNoteAsync">
                <input type="text" maxlength="300" placeholder="Своя подсказка: ассоциация, созвучие…" aria-label="Своя подсказка"
                       @bind="_note" @bind:event="oninput" />
                <button type="submit" class="btn small" disabled="@(_saving || _note == (d.Note ?? string.Empty))">Сохранить</button>
            </form>
            @if (_noteError is not null)
            {
                <p class="notice error small">@_noteError</p>
            }
        }
        else if (d.Note is not null)
        {
            <p class="note-text">💡 @d.Note</p>
        }

        <div class="flag-row">
            @if (d.Flag is { } flag)
            {
                <p class="flag-text small">
                    <span>⚑ Перевод отмечен для проверки@(flag.Note is not null ? $": «{flag.Note}»" : ".")</span>
                    <button type="button" class="link-button small" disabled="@_flagging" @onclick="UnflagAsync">снять</button>
                </p>
            }
            else if (_flagOpen)
            {
                <form class="note-form" @onsubmit="FlagAsync">
                    <input type="text" maxlength="300" placeholder="Как правильно? Можно оставить пустым" aria-label="Как правильно"
                           @bind="_flagNote" @bind:event="oninput" />
                    <button type="submit" class="btn small" disabled="@_flagging">Отметить</button>
                </form>
            }
            else
            {
                <button type="button" class="link-button small flag-button" @onclick="() => _flagOpen = true">Перевод неточный?</button>
            }
            @if (_flagError is not null)
            {
                <p class="notice error small">@_flagError</p>
            }
        </div>
    </div>
}

@code {
    private WordDetailsDto? _details;
    private int _loadedFor;
    private string _note = string.Empty;
    private string? _noteError;
    private bool _saving;
    private bool _flagOpen;
    private bool _flagging;
    private string _flagNote = string.Empty;
    private string? _flagError;

    [Parameter, EditorRequired]
    public int WordId { get; set; }

    [Parameter]
    public bool ShowNote { get; set; } = true;

    protected override async Task OnParametersSetAsync()
    {
        if (WordId == _loadedFor)
        {
            return;
        }

        _loadedFor = WordId;
        _details = null;
        _noteError = null;
        _flagOpen = false;
        _flagNote = string.Empty;
        _flagError = null;
        try
        {
            _details = await Api.GetWordDetailsAsync(WordId);
            _note = _details.Note ?? string.Empty;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Memory aids are optional: the card works without them.
            _details = null;
        }
    }

    private async Task SaveNoteAsync()
    {
        if (_details is null)
        {
            return;
        }

        _saving = true;
        _noteError = null;
        try
        {
            await Api.SaveWordNoteAsync(_details.WordId, _note);
            _details = _details with { Note = _note.Trim().Length == 0 ? null : _note.Trim() };
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _noteError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Keeps the doubt for a later fix of the deck; the card itself does not change.</summary>
    private Task FlagAsync() => ChangeFlagAsync(async id => await Api.FlagTranslationAsync(id, _flagNote));

    private Task UnflagAsync() => ChangeFlagAsync(async id =>
    {
        await Api.UnflagTranslationAsync(id);
        return null;
    });

    private async Task ChangeFlagAsync(Func<int, Task<TranslationFlagDto?>> change)
    {
        if (_details is null)
        {
            return;
        }

        int wordId = _details.WordId;
        _flagging = true;
        _flagError = null;
        try
        {
            var flag = await change(wordId);
            // The card may have moved on to the next word while the request was out.
            if (_details?.WordId == wordId)
            {
                _details = _details with { Flag = flag };
                _flagOpen = false;
                _flagNote = string.Empty;
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _flagError = _details?.WordId == wordId ? ex.Message : null;
        }
        finally
        {
            _flagging = false;
        }
    }
}
