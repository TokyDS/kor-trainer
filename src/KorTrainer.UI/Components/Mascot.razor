@* One pose of the trainer's companions, drawn as a bundled SVG. Decorative unless Alt is given. *@
@inject AppState State

@if (State.Settings.ShowCompanions)
{
    <img class="mascot @Motion" src="_content/KorTrainer.UI/img/mascot/@(Pose).svg" width="@Size" alt="@Alt" decoding="async" />
}

@code {
    /// <summary>One of <see cref="MascotPose"/>.</summary>
    [Parameter, EditorRequired]
    public string Pose { get; set; } = string.Empty;

    /// <summary>Width in CSS pixels; the height follows the drawing.</summary>
    [Parameter]
    public int Size { get; set; } = 120;

    [Parameter]
    public string Alt { get; set; } = string.Empty;

    /// <summary>Optional motion: <c>hop</c> once on appearing, <c>sway</c> gently; off under reduced motion.</summary>
    [Parameter]
    public string? Motion { get; set; }
}
