@* Multiple-choice drill shared by all modules: keyboard control, instant feedback, retry of misses. *@
@inherits KeyboardComponentBase
@inject IKorTrainerApi Api
@inject AppState State
@inject DevicePreferences Preferences
@inject IHaptics Haptics

<section class="drill">
    @if (OnFinished.HasDelegate)
    {
        <h2 class="drill-title">@(_set?.Title ?? Heading)</h2>
    }
    else
    {
        <header class="page-header">
            <a class="back" href="@BackHref">← Назад</a>
            <h1>@(_set?.Title ?? Heading)</h1>
            @if (Subtitle is not null)
            {
                <p class="muted">@Subtitle</p>
            }
        </header>
    }

    <VoiceNotice Compact="true" />
    <StatusViews IsLoading="_loading" Error="@_error" OnRetry="LoadAsync" />

    @if (!_loading && _error is null && _set is not null)
    {
        @if (_finished)
        {
            <div class="card summary">
                <h2>@(SelfCheck ? "Проверка себя завершена" : "Подход завершён")</h2>
                <p class="big-number">@_firstTryCorrect / @_uniqueCount</p>
                <p class="muted">правильно с первого раза · @AccuracyText</p>
                @if (_missed.Count > 0)
                {
                    <div class="missed">
                        <strong>Что повторить</strong>
                        <ul>
                            @for (int m = 0; m < _missed.Count; m++)
                            {
                                int missIndex = m;
                                var miss = _missed[m];
                                <li>
                                    <span class="missed-line">
                                        <span lang="ko">@miss.Options[miss.CorrectIndex].Text</span>
                                        <span class="muted small">@(miss.Prompt.Length > LongPromptLength ? string.Empty : miss.Prompt)</span>
                                        @if (RuleOf(miss) is not null)
                                        {
                                            <button type="button" class="link-button small" @onclick="() => _missedRule = _missedRule == missIndex ? null : missIndex">правило</button>
                                        }
                                    </span>
                                    @if (SelfCheck)
                                    {
                                        <span class="small">@miss.Explanation</span>
                                    }
                                    @if (_missedRule == missIndex && RuleOf(miss) is { } missRule)
                                    {
                                        <RuleRecap Steps="missRule.Steps" Pitfall="@missRule.Pitfall" Open="true" />
                                    }
                                </li>
                            }
                        </ul>
                        <span class="muted small">Ошибки вернутся в «Работе над ошибками» через 1, 3 и 7 дней; ответы с подсказкой тоже стоит повторить.</span>
                    </div>
                }
                @if (!OnFinished.HasDelegate)
                {
                    <NextTaskCard />
                }
                <div class="actions">
                    @if (SelfCheckHref is not null && !SelfCheck)
                    {
                        <a class="btn" href="@SelfCheckHref">Проверить себя без подсказок</a>
                    }
                    @if (OnFinished.HasDelegate)
                    {
                        <button type="button" class="btn primary" @onclick="FinishAsync">@FinishLabel <kbd>Enter</kbd></button>
                        <button type="button" class="btn" @onclick="LoadAsync">Ещё подход</button>
                    }
                    else
                    {
                        <button type="button" class="btn primary" @onclick="LoadAsync">Ещё подход <kbd>Enter</kbd></button>
                        <a class="btn" href="/step">К задачам шага</a>
                    }
                </div>
            </div>
        }
        else if (Current is { } item)
        {
            <div class="progress-track" aria-hidden="true"><div class="progress-fill" style="width: @ProgressPercent%"></div></div>
            <p class="counter muted">@(_position + 1) из @_items.Count</p>

            <div class="card prompt">
                <div class="prompt-main">
                    <HangulText Text="@item.Prompt" Romanization="@item.PromptRomanization" Size="@(item.Prompt.Length > LongPromptLength ? "passage" : IsKorean(item.Prompt) || item.Prompt.Length <= 12 ? "xl" : "lg")" />
                    @if (item.SpeakText is not null && (item.AutoSpeak || _selected is not null))
                    {
                        <SpeakButton Text="@item.SpeakText" />
                    }
                </div>
                @if (item.PromptNote is not null)
                {
                    <p class="muted">@item.PromptNote</p>
                }
                @if (_selected is null && !SelfCheck && HintFor(item) is { } hint)
                {
                    @if (_hinted)
                    {
                        <p class="hint" role="status">💡 @hint</p>
                    }
                    else
                    {
                        <button type="button" class="link-button small hint-button" @onclick="() => _hinted = true">💡 Подсказка</button>
                    }
                }
            </div>

            <div class="options" role="group" aria-label="Варианты ответа">
                @for (int i = 0; i < item.Options.Count; i++)
                {
                    int index = i;
                    var option = item.Options[i];
                    bool playable = _selected is not null && IsKorean(option.Text);
                    <button type="button" class="option @OptionClass(item, index) @(playable ? "playable" : string.Empty)"
                            aria-disabled="@((_selected is not null && !playable).ToString().ToLowerInvariant())"
                            title="@(playable ? "Послушать этот вариант" : null)" @onclick="() => OnOptionAsync(index)">
                        <span class="key">@(playable ? "▶" : (index + 1).ToString())</span>
                        <span class="option-body">
                            <HangulText Text="@option.Text" Romanization="@option.Romanization" Size="@(option.Text.Length > LongOptionLength ? "sentence" : "lg")" />
                            @if (option.Hint is not null)
                            {
                                <small class="muted">@option.Hint</small>
                            }
                        </span>
                    </button>
                }
            </div>

            @if (_selected is { } selected && !SelfCheck)
            {
                bool correct = selected == item.CorrectIndex;
                @* Pinned to the bottom of the screen: the verdict and «Дальше» stay under the thumb, details unfold on demand. *@
                <div class="feedback @(correct ? "ok" : "bad")" role="status" @onclick="HoldAutoAdvance">
                    <div class="feedback-head">
                        @if (correct)
                        {
                            <strong>Верно!</strong>
                        }
                        else
                        {
                            <strong>Неверно — нужно <span lang="ko">@item.Options[item.CorrectIndex].Text</span></strong>
                        }
                        <button type="button" class="btn primary" @onclick="NextAsync" @onclick:stopPropagation="true">Дальше <kbd>Enter</kbd></button>
                    </div>
                    @if (_autoAdvancing)
                    {
                        <div class="auto-advance" aria-hidden="true"><span></span></div>
                    }
                    @if (!correct && item.Options[selected].Why is { } why)
                    {
                        <p class="feedback-why">Вы выбрали <span lang="ko">@item.Options[selected].Text</span>: @why</p>
                    }
                    <details class="feedback-more" open="@_showRule">
                        <summary>@(correct ? "Почему так" : "Разбор и правило")</summary>
                        <p><TapKorean Text="@item.Explanation" /></p>
                        @if (RuleOf(item) is { } rule)
                        {
                            <RuleRecap Steps="rule.Steps" Pitfall="@rule.Pitfall" Open="_showRule" />
                        }
                    </details>
                </div>
            }

            @if (_syncError is not null)
            {
                <p class="notice error small">Ответ не сохранился: @_syncError</p>
            }

            <p class="keys-hint">
                @if (_selected is null)
                {
                    <span><kbd>1</kbd>–<kbd>@item.Options.Count</kbd> ответ · <kbd>Enter</kbd> дальше · <kbd>Пробел</kbd> озвучить</span>
                }
                else
                {
                    <span><kbd>1</kbd>–<kbd>@item.Options.Count</kbd> послушать варианты · <kbd>Enter</kbd> дальше · <kbd>Пробел</kbd> озвучить</span>
                }
            </p>
        }
    }
</section>

@code {
    private const int MaxCountedResponseMs = 60_000;

    /// <summary>Longer prompts (TOPIK passages, notices) are set as running text.</summary>
    private const int LongPromptLength = 30;

    /// <summary>Whole-sentence options (TOPIK statements) use running-text size.</summary>
    private const int LongOptionLength = 12;

    private readonly System.Diagnostics.Stopwatch _itemTimer = new();
    private readonly HashSet<string> _retried = [];
    private List<ChoiceExerciseDto> _items = [];
    private ExerciseSetDto? _set;
    private int _position;
    private int? _selected;
    private bool _showRule;
    private bool _hinted;
    private readonly List<ChoiceExerciseDto> _missed = [];
    private int? _missedRule;
    private bool _autoAdvancing;
    private int _advanceVersion;

    /// <summary>How long a right answer stays on screen before the next item when moving on by itself.</summary>
    private static readonly TimeSpan AutoAdvanceDelay = TimeSpan.FromMilliseconds(1100);
    private bool _loading = true;
    private bool _reloading;
    private bool _finished;
    private bool _speakPending;
    private string? _error;
    private string? _syncError;
    private int _uniqueCount;
    private int _firstTryCorrect;
    private DateTime _sessionStartUtc;
    private long _activeMs;
    private bool _sessionSaved;

    [Parameter, EditorRequired]
    public Func<Task<ExerciseSetDto>> Load { get; set; } = default!;

    [Parameter]
    public string Heading { get; set; } = "Упражнение";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string BackHref { get; set; } = "/";

    /// <summary>Set when the drill is one part of a longer session: the summary then offers to move on.</summary>
    /// <summary>No feedback between questions; the summary explains the mistakes at the end.</summary>
    [Parameter]
    public bool SelfCheck { get; set; }

    /// <summary>Where the same drill runs as a self-check, offered in the summary.</summary>
    [Parameter]
    public string? SelfCheckHref { get; set; }

    [Parameter]
    public EventCallback OnFinished { get; set; }

    [Parameter]
    public string FinishLabel { get; set; } = "Дальше";

    private ChoiceExerciseDto? Current => _position < _items.Count ? _items[_position] : null;

    private int ProgressPercent => _items.Count == 0 ? 0 : _position * 100 / _items.Count;

    private string AccuracyText => _uniqueCount == 0 ? "—" : $"{_firstTryCorrect * 100 / _uniqueCount}%";

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_speakPending && Current is { AutoSpeak: true } item)
        {
            _speakPending = false;
            await State.SpeakAsync(item.SpeakText, slow: item.AutoSpeak);
        }
    }

    protected override async Task HandleKeyAsync(string key)
    {
        if (_finished)
        {
            if (key == "Enter")
            {
                await (OnFinished.HasDelegate ? FinishAsync() : LoadAsync());
            }

            return;
        }

        if (Current is not { } item)
        {
            return;
        }

        if (key == "Space")
        {
            // Before answering, only listening drills may be voiced; otherwise audio would give the answer away.
            if (item.AutoSpeak || _selected is not null)
            {
                await State.SpeakAsync(item.SpeakText, slow: item.AutoSpeak);
            }
        }
        else if (key == "Enter" && _selected is not null)
        {
            await NextAsync();
        }
        else if (DigitOf(key) is { } digit && digit <= item.Options.Count)
        {
            await OnOptionAsync(digit - 1);
        }
    }

    private async Task LoadAsync()
    {
        if (_reloading)
        {
            return;
        }

        _reloading = true;
        await State.InitializeAsync(); // the recorded-word list decides between a recording and synthesis
        await SaveSessionAsync();
        _loading = true;
        _error = null;
        try
        {
            _set = await Load();
            _items = [.. _set.Items];
            _retried.Clear();
            _missed.Clear();
            _hinted = false;
            _missedRule = null;
            _position = 0;
            _selected = null;
            _finished = false;
            _uniqueCount = _items.Count;
            _firstTryCorrect = 0;
            _sessionStartUtc = DateTime.UtcNow;
            _activeMs = 0;
            _sessionSaved = false;
            ShowCurrent();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            _reloading = false;
        }
    }

    private async Task AnswerAsync(int index)
    {
        if (Current is not { } item || _selected is not null)
        {
            return;
        }

        _itemTimer.Stop();
        int elapsed = (int)Math.Min(_itemTimer.ElapsedMilliseconds, int.MaxValue);
        _activeMs += Math.Min(elapsed, MaxCountedResponseMs);
        _selected = index;
        bool correct = index == item.CorrectIndex;

        bool firstTry = !_retried.Contains(item.ItemKey);
        // A right answer after the hint is not counted as known: it is listed to repeat.
        if (firstTry && correct && !_hinted)
        {
            _firstTryCorrect++;
        }
        else if (firstTry && correct && _hinted)
        {
            _missed.Add(item);
        }

        // A missed item comes back once at the end of the set (not in a self-check) and is listed in the summary.
        if (firstTry && !correct)
        {
            _retried.Add(item.ItemKey);
            _missed.Add(item);
            if (!SelfCheck)
            {
                _items.Add(item);
            }
        }

        await SignalAsync(correct);

        if (!item.AutoSpeak && item.SpeakText is not null)
        {
            await State.SpeakAsync(item.SpeakText, slow: item.AutoSpeak);
        }

        try
        {
            // A first slip carries the exercise along, so it can come back in «Работа над ошибками».
            var exercise = firstTry && !correct ? item : null;
            await Api.RecordAttemptsAsync([new AttemptDto(item.Module ?? _set!.Module, item.Type, item.ItemKey, correct, elapsed, exercise)]);
            _syncError = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _syncError = ex.Message;
        }
        // A self-check shows nothing between questions; otherwise a right answer may move on by itself.
        if (SelfCheck)
        {
            await NextAsync();
        }
        else if (correct && Preferences.AutoAdvance)
        {
            await AutoAdvanceAsync();
        }
    }

    /// <summary>A soft sound for a right answer, a buzz for a wrong one, as this device is set up.</summary>
    private async Task SignalAsync(bool correct)
    {
        if (correct && Preferences.Sound)
        {
            await Browser.InvokeVoidAsync("chime");
        }
        else if (!correct && Preferences.Vibrate)
        {
            await Haptics.BuzzAsync();
        }
    }

    /// <summary>A right answer moves on by itself after a moment, unless the learner touches the feedback.</summary>
    private async Task AutoAdvanceAsync()
    {
        int version = ++_advanceVersion;
        _autoAdvancing = true;
        StateHasChanged();
        await Task.Delay(AutoAdvanceDelay);
        if (version == _advanceVersion && _autoAdvancing && _selected is not null)
        {
            await NextAsync();
        }
    }

    private void HoldAutoAdvance()
    {
        _autoAdvancing = false;
        _advanceVersion++;
    }

    /// <summary>Before answering a click answers; afterwards it plays the option, so similar sounds can be compared.</summary>
    private async Task OnOptionAsync(int index)
    {
        if (Current is not { } item)
        {
            return;
        }

        if (_selected is null)
        {
            await AnswerAsync(index);
        }
        else if (IsKorean(item.Options[index].Text))
        {
            HoldAutoAdvance();
            await State.SpeakAsync(item.Options[index].Text, slow: item.AutoSpeak);
        }
    }

    private static bool IsKorean(string text) => text.Any(KorTrainer.Domain.Hangul.Syllable.IsSyllable);

    /// <summary>The first step of the rule for a grammar item, before answering.</summary>
    private string? HintFor(ChoiceExerciseDto item) =>
        (item.Module ?? _set?.Module) == StudyModule.Grammar ? KorTrainer.Domain.Exercises.GrammarHints.For(item.Prompt) : null;

    /// <summary>The rule behind a grammar or number item, to look up from its feedback without leaving the set.</summary>
    private (string Title, IReadOnlyList<string> Steps, string Pitfall)? RuleOf(ChoiceExerciseDto item) => (item.Module ?? _set?.Module) switch
    {
        StudyModule.Grammar when KorTrainer.Domain.Grammar.GrammarTheories.Find(item.Type) is { } g =>
            (KorTrainer.Domain.Grammar.GrammarCatalog.Find(item.Type)?.Title ?? item.Type, g.Steps, g.Pitfall),
        StudyModule.Numbers when KorTrainer.Domain.Numbers.NumberTheories.Find(item.Type) is { } n => (n.Title, n.Steps, n.Pitfall),
        _ => null,
    };

    private async Task NextAsync()
    {
        await Browser.BlurActiveAsync();
        _position++;
        _selected = null;
        _showRule = false;
        _hinted = false;
        HoldAutoAdvance();
        if (_position >= _items.Count)
        {
            _finished = true;
            await SaveSessionAsync();
            return;
        }

        ShowCurrent();
    }

    private void ShowCurrent()
    {
        _itemTimer.Restart();
        _speakPending = true;
    }

    private async Task FinishAsync()
    {
        await SaveSessionAsync();
        await OnFinished.InvokeAsync();
    }

    private async Task SaveSessionAsync()
    {
        int seconds = (int)(_activeMs / 1000);
        if (_sessionSaved || seconds < 1 || _set is null)
        {
            return;
        }

        _sessionSaved = true;
        try
        {
            await Api.RecordSessionAsync(new SessionDto(_set.Module, _sessionStartUtc, seconds));
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _syncError = ex.Message;
        }
    }

    private string OptionClass(ChoiceExerciseDto item, int index)
    {
        if (_selected is not { } selected)
        {
            return string.Empty;
        }

        if (index == item.CorrectIndex)
        {
            return "correct";
        }

        return index == selected ? "wrong" : "dimmed";
    }

    public override async ValueTask DisposeAsync()
    {
        await SaveSessionAsync();
        await base.DisposeAsync();
    }
}
