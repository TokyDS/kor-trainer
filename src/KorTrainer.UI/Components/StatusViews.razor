@* While loading: grey placeholders in the shape of cards (the page does not jump when it arrives); on error, the reason and a retry. *@
@if (Error is not null)
{
    <div class="notice error" role="alert">
        <strong>Не получилось загрузить данные.</strong>
        <p>@Error</p>
        @if (OnRetry.HasDelegate)
        {
            <button type="button" class="btn" @onclick="OnRetry">Повторить</button>
        }
    </div>
}
else if (IsLoading)
{
    <div class="skeleton" role="status" aria-live="polite">
        <span class="visually-hidden">Загрузка…</span>
        <div class="skeleton-card" aria-hidden="true">
            <span class="skeleton-line short"></span>
            <span class="skeleton-line"></span>
            <span class="skeleton-line medium"></span>
        </div>
        <div class="skeleton-card" aria-hidden="true">
            <span class="skeleton-line medium"></span>
            <span class="skeleton-line"></span>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
