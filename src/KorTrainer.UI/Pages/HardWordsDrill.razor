@page "/vocab/hard/{Type}"
@inject IKorTrainerApi Api

<PageTitle>Трудные слова — KorTrainer</PageTitle>

<ChoiceDrill @key="Type" Load="LoadAsync" BackHref="/vocab/hard" />

@code {
    private const int SetSize = 20;

    [Parameter]
    public string Type { get; set; } = string.Empty;

    private Task<ExerciseSetDto> LoadAsync() => Api.GetHardExercisesAsync(Type, SetSize);
}
