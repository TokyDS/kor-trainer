@page "/hangul/{Type}"
@inject IKorTrainerApi Api

<PageTitle>Хангыль — KorTrainer</PageTitle>

@if (!ExerciseTypes.HangulChoice.Contains(Type))
{
    <p class="notice error">Неизвестное упражнение. <a href="/hangul">Вернуться к хангылю</a></p>
}
else
{
    @* The key forces a fresh drill when the type or level in the URL changes. *@
    <ChoiceDrill @key="@($"{Type}:{EffectiveLevel}:{Focus}")" Load="LoadAsync" BackHref="@BackHref" Subtitle="@Subtitle" />
}

@code {
    private const int SetSize = 20;

    [Parameter]
    public string Type { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public int? Level { get; set; }

    /// <summary>For the consonant series: one row only (ㄷ → ㄷ · ㅌ · ㄸ).</summary>
    [SupplyParameterFromQuery]
    public string? Focus { get; set; }

    private string? FocusRow => Type == ExerciseTypes.ConsonantSeries && Focus is { Length: 1 } f
        && KorTrainer.Domain.Hangul.JamoCatalog.ConsonantSeries.FirstOrDefault(r => r.Contains(f[0])) is { } row
            ? string.Join(" · ", row)
            : null;

    private string Subtitle => FocusRow is { } row ? $"Ряд {row}" : $"Уровень {EffectiveLevel}";

    private string BackHref => Type == ExerciseTypes.ConsonantSeries ? "/hangul/series" : "/hangul";

    private int EffectiveLevel => Type is ExerciseTypes.FinalSound or ExerciseTypes.SoundChange
        ? 3
        : Math.Clamp(Level ?? 1, 1, 3);

    private Task<ExerciseSetDto> LoadAsync() =>
        Api.GetHangulExercisesAsync(Type, EffectiveLevel, SetSize, FocusRow is null ? null : Focus);
}
