@page "/vocab/review"
@inherits KeyboardComponentBase
@inject IKorTrainerApi Api
@inject AppState State
@using KorTrainer.Domain.Hangul

<PageTitle>Повторение слов — KorTrainer</PageTitle>

<header class="page-header">
    <a class="back" href="/vocab">← Словарь</a>
    <h1>Повторение слов</h1>
    <nav class="segmented" aria-label="Направление">
        <a class="@(IsReverse ? string.Empty : "active")" href="/vocab/review" aria-current="@(!IsReverse)">한 → RU</a>
        <a class="@(IsReverse ? "active" : string.Empty)" href="/vocab/review?mode=reverse" aria-current="@IsReverse">RU → 한, ввод</a>
    </nav>
    @if (_queue is { } q && !_done)
    {
        <p class="muted">К повторению: @q.DueCount · новых сегодня осталось: @q.NewRemainingToday</p>
    }
</header>

<StatusViews IsLoading="_loading" Error="@_error" OnRetry="LoadAsync" />

@if (!_loading && _error is null)
{
    @if (_done)
    {
        <div class="card summary">
            <h2>На сейчас всё!</h2>
            <p class="big-number">@_reviewed</p>
            <p class="muted">карточек повторено за подход</p>
            @if (_nextLearningDue is { } next)
            {
                <p class="muted">Следующая карточка в изучении будет готова в @next.ToLocalTime().ToString("HH:mm").</p>
            }
            <div class="actions">
                <a class="btn primary" href="/">К задачам дня</a>
                <a class="btn" href="/vocab">Словарь</a>
            </div>
        </div>
    }
    else if (_card is { } card)
    {
        <div class="card flashcard @(_revealed ? "revealed" : string.Empty)">
            <span class="phase-badge">@PhaseLabel(card.Phase)</span>
            @if (IsReverse && !_revealed)
            {
                <div class="flash-front">
                    <p class="translation big">@card.Russian</p>
                </div>
                <p class="muted small">@card.Topic</p>
            }
            else if (IsReverse && _check is { } check)
            {
                <div class="flash-front">
                    <span class="answer-diff" lang="ko">
                        @foreach (var syllable in check.Syllables)
                        {
                            <span class="@(syllable.IsMatch ? "ok" : "bad")">@syllable.Expected</span>
                        }
                    </span>
                    <SpeakButton Text="@card.Korean" />
                </div>
                <p class="@(check.IsCorrect ? "notice success" : "notice error") small">
                    @if (check.IsCorrect)
                    {
                        <span>Верно!</span>
                    }
                    else
                    {
                        <span>Вы написали: <span lang="ko">@_answer</span></span>
                        @foreach (var note in check.Syllables.Where(x => x.Note is not null))
                        {
                            <br /><span lang="ko">@note.Note</span>
                        }
                        @if (check.Extra.Length > 0)
                        {
                            <br /><span lang="ko">лишнее: @check.Extra</span>
                        }
                    }
                </p>
            }
            else
            {
                <div class="flash-front">
                    <HangulText Text="@card.Korean" Size="xl" />
                    @if (_revealed)
                    {
                        <SpeakButton Text="@card.Korean" />
                    }
                </div>
            }
            @if (_revealed)
            {
                <div class="flash-back">
                    @if (card.Pronounced != card.Korean)
                    {
                        <p class="pronounced" lang="ko">[@card.Pronounced]</p>
                    }
                    <p class="translation">@card.Russian</p>
                    <p class="muted small">@card.Topic</p>
                </div>
            }
        </div>

        @if (!_revealed && IsReverse)
        {
            <form class="answer-form" @onsubmit="CheckAnswerAsync">
                <input type="text" lang="ko" autocomplete="off" autocapitalize="off" spellcheck="false"
                       placeholder="Напишите по-корейски" aria-label="Ответ на корейском" @bind="_answer" @bind:event="oninput" />
                <button type="submit" class="btn primary">Проверить</button>
                <button type="button" class="btn" @onclick="GiveUpAsync">Не помню</button>
            </form>
            <p class="keys-hint">Оценка влияет на ту же карточку, что и в режиме 한 → RU.</p>
        }
        else if (!_revealed)
        {
            <button type="button" class="btn primary wide" @onclick="RevealAsync">Показать перевод <kbd>Enter</kbd></button>
            <p class="keys-hint">Сначала вспомните перевод, потом откройте ответ.</p>
        }
        else
        {
            <div class="grades">
                @foreach (var preview in card.Previews)
                {
                    <button type="button" class="grade grade-@preview.Grade.ToString().ToLowerInvariant() @(preview.Grade == SuggestedGrade ? "suggested" : string.Empty)" disabled="@_saving" @onclick="() => GradeAsync(preview.Grade)">
                        <span class="key">@((int)preview.Grade)</span>
                        <span>@preview.Label</span>
                        <small>@preview.Interval</small>
                    </button>
                }
            </div>
            <p class="keys-hint"><kbd>1</kbd>–<kbd>4</kbd> оценка · <kbd>Пробел</kbd> озвучить</p>
        }

        @if (_syncError is not null)
        {
            <p class="notice error small">@_syncError</p>
        }
    }
}

@code {
    private readonly System.Diagnostics.Stopwatch _timer = new();
    private string _answer = string.Empty;
    private AnswerCheck? _check;

    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private bool IsReverse => Mode == "reverse";

    /// <summary>In typing mode the check suggests a grade: Good when right, Again when wrong.</summary>
    private Grade? SuggestedGrade => IsReverse && _revealed ? (_check?.IsCorrect == true ? Grade.Good : Grade.Again) : null;
    private readonly Queue<CardDto> _cards = new();
    private VocabularyQueueDto? _queue;
    private CardDto? _card;
    private DateTime? _nextLearningDue;
    private bool _revealed;
    private bool _loading = true;
    private bool _saving;
    private bool _done;
    private string? _error;
    private string? _syncError;
    private int _reviewed;
    private DateTime _sessionStartUtc = DateTime.UtcNow;
    private long _activeMs;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task HandleKeyAsync(string key)
    {
        if (_card is null || _done)
        {
            return;
        }

        if (!_revealed && !IsReverse && key is "Enter" or "Space")
        {
            await RevealAsync();
        }
        else if (_revealed && key == "Space")
        {
            await State.SpeakAsync(_card.Korean);
        }
        else if (_revealed && !_saving && DigitOf(key) is >= 1 and <= 4 and var digit)
        {
            await GradeAsync((Grade)digit);
        }
    }

    private async Task LoadAsync()
    {
        _loading = _card is null;
        _error = null;
        try
        {
            _queue = await Api.GetQueueAsync();
            _cards.Clear();
            foreach (var card in _queue.Cards)
            {
                _cards.Enqueue(card);
            }

            _nextLearningDue = _queue.NextLearningDueUtc;
            ShowNext();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CheckAnswerAsync()
    {
        if (_card is null || string.IsNullOrWhiteSpace(_answer))
        {
            return;
        }

        _check = AnswerChecker.Check(_card.Korean, _answer);
        await RevealAsync();
        await Browser.BlurActiveAsync(); // number keys now grade the card
    }

    private async Task GiveUpAsync()
    {
        if (_card is null)
        {
            return;
        }

        _check = AnswerChecker.Check(_card.Korean, string.Empty);
        await RevealAsync();
        await Browser.BlurActiveAsync();
    }

    private void ShowNext()
    {
        _revealed = false;
        _answer = string.Empty;
        _check = null;
        if (_cards.TryDequeue(out var next))
        {
            _card = next;
            _done = false;
            _timer.Restart();
        }
        else
        {
            _card = null;
            _done = true;
        }
    }

    private async Task RevealAsync()
    {
        _revealed = true;
        await State.SpeakAsync(_card?.Korean);
    }

    private async Task GradeAsync(Grade grade)
    {
        if (_card is null || _saving)
        {
            return;
        }

        _saving = true;
        _timer.Stop();
        int elapsed = (int)Math.Min(_timer.ElapsedMilliseconds, int.MaxValue);
        _activeMs += Math.Min(elapsed, 60_000);
        try
        {
            await Api.ReviewAsync(new ReviewRequest(_card.WordId, grade, elapsed));
            _reviewed++;
            _syncError = null;
            await Browser.BlurActiveAsync();
            if (_cards.Count == 0)
            {
                // Learning cards answered just now may already be due again (1–10 min steps).
                await LoadAsync();
            }
            else
            {
                ShowNext();
            }

            if (_done)
            {
                await SaveSessionAsync();
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _syncError = $"Оценка не сохранилась: {ex.Message}";
            _timer.Start();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveSessionAsync()
    {
        int seconds = (int)(_activeMs / 1000);
        if (seconds < 1)
        {
            return;
        }

        _activeMs = 0;
        try
        {
            await Api.RecordSessionAsync(new SessionDto(StudyModule.Vocabulary, _sessionStartUtc, seconds));
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _syncError = ex.Message;
        }

        _sessionStartUtc = DateTime.UtcNow;
    }

    private static string PhaseLabel(CardPhase phase) => phase switch
    {
        CardPhase.New => "новое",
        CardPhase.Learning => "изучение",
        CardPhase.Relearning => "переучивание",
        _ => "повторение",
    };

    public override async ValueTask DisposeAsync()
    {
        await SaveSessionAsync();
        await base.DisposeAsync();
    }
}
