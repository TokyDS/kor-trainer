@page "/hanja/drill/{Type}"
@inject IKorTrainerApi Api

<PageTitle>Ханча — KorTrainer</PageTitle>

<ChoiceDrill @key="Type" Load="LoadAsync" BackHref="/hanja" />

@code {
    private const int SetSize = 15;

    [Parameter]
    public string Type { get; set; } = string.Empty;

    private Task<ExerciseSetDto> LoadAsync() => Api.GetHanjaExercisesAsync(Type, SetSize);
}
