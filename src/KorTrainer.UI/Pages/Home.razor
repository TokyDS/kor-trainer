@page "/"
@inject IKorTrainerApi Api
@inject NavigationManager Navigation

<PageTitle>KorTrainer</PageTitle>

<StatusViews IsLoading="(_today is null || _plan is null) && _error is null" Error="@_error" OnRetry="LoadAsync" />

@if (_today is { } today && _plan is { } plan)
{
    var step = today.Step;
    int done = step.Tasks.Count(t => t.IsDone);

    @if (_reminder is { ShouldRemind: true } reminder)
    {
        <div class="notice warning reminder" role="status">
            <strong>@reminder.Title</strong>
            <p>@reminder.Message</p>
        </div>
    }

    <header class="map-hero">
        <a class="continue" href="/step">
            <span class="eyebrow">Продолжить · @step.StageTitle</span>
            <strong class="continue-title">@step.Title</strong>
            <span class="continue-meta">
                <span class="progress-track small" aria-hidden="true"><span class="progress-fill" style="width: @(step.Tasks.Count == 0 ? 0 : done * 100 / step.Tasks.Count)%"></span></span>
                <span class="muted small">@done из @step.Tasks.Count задач · шаг @step.Number из @step.TotalSteps</span>
            </span>
        </a>
        @if (today.Week is { Count: > 0 } week)
        {
            <ol class="week-strip" aria-label="Дни занятий за последнюю неделю">
                @foreach (var day in week)
                {
                    <li class="@(day.Studied ? "studied" : string.Empty) @(day.IsToday ? "today" : string.Empty)"
                        title="@(day.Studied ? "были занятия" : "без занятий")">
                        <span class="week-cell" aria-hidden="true"></span>
                        <span>@day.Label</span>
                        <span class="visually-hidden">@(day.Studied ? "занимались" : "нет")</span>
                    </li>
                }
            </ol>
        }
    </header>

    <a class="quick-start" href="/quick">
        <span class="quick-glyph" aria-hidden="true">10′</span>
        <span class="quick-text">
            <strong>10 минут</strong>
            <span>Повторить слова и сделать упражнения шага — одной кнопкой</span>
        </span>
    </a>
    @if (_mistakes is { Due: > 0 } mistakes)
    {
        <a class="mistakes-link" href="/mistakes">
            <span>Работа над ошибками</span>
            <span class="badge">@mistakes.Due</span>
        </a>
    }

    <h2 class="map-heading">План до TOPIK</h2>
    <p class="muted small">Нажмите на шаг, чтобы открыть его задачи. Пройденные можно повторить, следующие — посмотреть заранее.</p>
    <PathMap Plan="plan" FoldDone="true" ScrollToCurrent="false" />
}

@code {
    private const int ReminderHour = 18;

    private TodayDto? _today;
    private PlanDto? _plan;
    private ReminderDto? _reminder;
    private MistakeSummaryDto? _mistakes;
    private string? _error;

    /// <summary>Old links (<c>/?step=level1-2</c>) open the step's own page.</summary>
    [SupplyParameterFromQuery(Name = "step")]
    public string? StepParameter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (StepParameter is { Length: > 0 } key)
        {
            Navigation.NavigateTo($"/step/{Uri.EscapeDataString(key)}", replace: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _today = await Api.GetTodayAsync(null);
            _plan = await Api.GetPlanAsync();
            // Evening nudge, mirroring the desktop and phone reminders.
            _reminder = DateTime.Now.Hour >= ReminderHour ? await Api.GetReminderAsync() : null;
            _mistakes = await Api.GetMistakeSummaryAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex.Message;
        }
    }
}
