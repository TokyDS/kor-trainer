@page "/stats"
@inject IKorTrainerApi Api

<PageTitle>Статистика — KorTrainer</PageTitle>

<header class="page-header">
    <h1>Статистика</h1>
</header>

<StatusViews IsLoading="_overview is null && _error is null" Error="@_error" OnRetry="LoadAsync" />

@if (_overview is { } o && _daily is { } daily)
{
    <dl class="stat-tiles">
        <div class="tile hero"><dt>выучено слов</dt><dd>@o.Vocabulary.Mature</dd><span class="muted">интервал 21+ день</span></div>
        <div class="tile"><dt>в изучении</dt><dd>@(o.Vocabulary.Learning + o.Vocabulary.Young)</dd></div>
        <div class="tile"><dt>минут занятий</dt><dd>@o.TotalStudyMinutes</dd></div>
        <div class="tile"><dt>дней с занятиями</dt><dd>@o.ActiveDays</dd></div>
        <div class="tile"><dt>за неделю / за месяц</dt><dd>@o.ActiveDaysThisWeek / @o.ActiveDaysThisMonth</dd><span class="muted">дней с занятиями</span></div>
        <div class="tile"><dt>чтение, мс/слог</dt><dd>@(o.ReadingMsPerSyllable?.ToString("0") ?? "—")</dd></div>
    </dl>

    @if (_forecast is { } f)
    {
        <section class="card forecast" aria-labelledby="forecast-heading">
            <div class="section-head">
                <h2 id="forecast-heading">Прогноз по словам</h2>
                <span class="muted">в колоде @f.WordsStudied · недавний темп @f.PacePerDay.ToString("0.#") в день</span>
            </div>
            <ul class="goal-list">
                @foreach (var goal in f.Goals)
                {
                    int percent = Math.Min(100, f.WordsStudied * 100 / Math.Max(1, goal.Goal));
                    <li class="@(goal.Reached ? "on-track" : string.Empty)">
                        <div class="goal-head">
                            <strong>@goal.Title</strong>
                            <span class="muted">@goal.Goal слов</span>
                        </div>
                        <span class="accuracy-track"><span class="accuracy-fill" style="width: @percent%"></span></span>
                        <span class="goal-verdict">
                            @if (goal.Reached)
                            {
                                <span>✓ достигнуто</span>
                            }
                            else if (goal.ExpectedOn is { } expected)
                            {
                                <span>в этом темпе — примерно @expected.ToString("MMMM yyyy", Russian)</span>
                            }
                            else
                            {
                                <span class="muted">дата появится, когда начнёте учить новые слова</span>
                            }
                        </span>
                    </li>
                }
            </ul>
            <p class="muted small">
                Это ориентир, а не расписание. К TOPIK (@f.ExamDate.ToString("MMMM yyyy", Russian)) в этом темпе будет около @f.WordsByExam слов.
            </p>
        </section>
    }

    <section class="card" aria-labelledby="minutes-heading">
        <div class="section-head">
            <h2 id="minutes-heading">Время занятий по дням, минуты</h2>
            <span class="muted">последние @Days дней · всего @daily.Sum(d => d.StudyMinutes) мин</span>
        </div>
        <div class="bar-chart" role="img" aria-label="Минуты занятий по дням за последние @Days дней">
            <span class="bar-max muted">@MaxMinutes</span>
            @foreach (var day in daily)
            {
                <div class="bar-col" tabindex="0" aria-label="@day.Date.ToString("d MMMM", Russian): @day.StudyMinutes мин">
                    <span class="bar" style="height: @(day.StudyMinutes * 100 / MaxMinutes)%"></span>
                    <span class="bar-tip">
                        <strong>@day.Date.ToString("d MMM", Russian)</strong>
                        @day.StudyMinutes мин · ответов @day.Answers · повторений @day.Reviews
                    </span>
                </div>
            }
        </div>
        <div class="bar-axis muted">
            <span>@daily[0].Date.ToString("d MMM", Russian)</span>
            <span>сегодня</span>
        </div>
    </section>

    <section class="card" aria-labelledby="accuracy-heading">
        <h2 id="accuracy-heading">Точность по модулям</h2>
        @if (o.Accuracy.Count == 0)
        {
            <p class="muted">Ответов пока нет.</p>
        }
        <ul class="accuracy-list">
            @foreach (var a in o.Accuracy)
            {
                int percent = a.Answers == 0 ? 0 : a.Correct * 100 / a.Answers;
                <li>
                    <span class="accuracy-label">@ModuleName(a.Module)</span>
                    <span class="accuracy-track"><span class="accuracy-fill" style="width: @percent%"></span></span>
                    <span class="accuracy-value">@percent% <span class="muted">из @a.Answers@(a.AnswersLast7Days > 0 ? $" · за неделю {a.CorrectLast7Days * 100 / a.AnswersLast7Days}%" : string.Empty)</span></span>
                </li>
            }
        </ul>
        <p class="muted small">Для словаря верным считается любой ответ, кроме «Снова».</p>
    </section>

    <details class="card">
        <summary>Таблица по дням</summary>
        <table class="words">
            <thead><tr><th>Дата</th><th>Минуты</th><th>Ответы</th><th>Верно</th><th>Повторения</th><th>Новые слова</th></tr></thead>
            <tbody>
                @foreach (var day in daily.Reverse())
                {
                    <tr><td>@day.Date.ToString("dd.MM")</td><td>@day.StudyMinutes</td><td>@day.Answers</td><td>@day.Correct</td><td>@day.Reviews</td><td>@day.NewWords</td></tr>
                }
            </tbody>
        </table>
    </details>
}

@code {
    private const int Days = 30;
    private static readonly System.Globalization.CultureInfo Russian = System.Globalization.CultureInfo.GetCultureInfo("ru-RU");

    private StatsOverviewDto? _overview;
    private IReadOnlyList<DailyStatDto>? _daily;
    private ForecastDto? _forecast;
    private string? _error;

    private int MaxMinutes => Math.Max(10, _daily?.Max(d => d.StudyMinutes) ?? 0);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var overview = Api.GetStatsOverviewAsync();
            var daily = Api.GetDailyStatsAsync(Days);
            _overview = await overview;
            _daily = await daily;
            _forecast = await Api.GetForecastAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex.Message;
        }
    }

    private static string ModuleName(StudyModule module) => module switch
    {
        StudyModule.Hangul => "Хангыль",
        StudyModule.Vocabulary => "Словарь",
        StudyModule.Grammar => "Грамматика",
        StudyModule.Numbers => "Числа",
        StudyModule.Topik => "TOPIK",
        StudyModule.Listening => "Аудирование",
        StudyModule.Hanja => "Ханча",
        StudyModule.Typing => "Набор текста",
        StudyModule.Reading => "Чтение",
        _ => module.ToString(),
    };
}
