@page "/plan"
@inject IKorTrainerApi Api

<PageTitle>План — KorTrainer</PageTitle>

<header class="page-header">
    <h1>План до TOPIK</h1>
    <p class="muted">Цель — TOPIK I уровень 2, в идеале TOPIK II уровень 3. Шаги идут в вашем темпе: следующий открывается, когда вы готовы.</p>
</header>

<StatusViews IsLoading="_plan is null && _error is null" Error="@_error" OnRetry="LoadAsync" />

@if (_plan is { } plan)
{
    <ol class="timeline">
        @foreach (var stage in plan.Stages)
        {
            bool isCurrent = plan.Steps.Any(s => s.Stage == stage.Stage && s.State == StepState.Current);
            <li class="@(isCurrent ? "current" : string.Empty)">
                <span class="timeline-dates">@StageProgress(stage)</span>
                <strong>@stage.Title</strong>
                <span class="muted">@stage.Goal</span>
                <div class="step-dots" aria-label="Шаги этапа">
                    @foreach (var step in plan.Steps.Where(s => s.Stage == stage.Stage))
                    {
                        <a class="step-dot @step.State.ToString().ToLowerInvariant()" href="@(step.Key == plan.CurrentKey ? "/" : $"/?step={step.Key}")"
                           title="@step.Title">@(step.State == StepState.Done ? "✓" : step.Number.ToString())</a>
                    }
                </div>
            </li>
        }
    </ol>

    <h2>Уроки 1–10</h2>
    <div class="lesson-list">
        @foreach (var lesson in plan.Lessons)
        {
            <details class="card" open="@($"lesson-{lesson.Day}" == plan.CurrentKey)">
                <summary><span class="day-number">Урок @lesson.Day</span> @lesson.Title</summary>
                <ul>
                    @foreach (var point in lesson.KeyPoints)
                    {
                        <li>@point</li>
                    }
                </ul>
            </details>
        }
    </div>
}

@code {
    private PlanDto? _plan;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static string StageProgress(StageDto stage) =>
        stage.DoneCount == stage.StepCount ? "пройдено" : $"{stage.DoneCount} из {stage.StepCount}";

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _plan = await Api.GetPlanAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex.Message;
        }
    }
}
