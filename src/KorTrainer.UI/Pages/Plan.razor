@page "/plan"
@inject IKorTrainerApi Api

<PageTitle>План — KorTrainer</PageTitle>

<header class="page-header">
    <h1>План до TOPIK</h1>
    <p class="muted">Цель: весной 2027 — минимум TOPIK I уровень 2, в идеале TOPIK II уровень 3.</p>
</header>

<StatusViews IsLoading="_plan is null && _error is null" Error="@_error" OnRetry="LoadAsync" />

@if (_plan is { } plan)
{
    <ol class="timeline">
        @foreach (var stage in plan.Stages)
        {
            <li class="@(stage.Stage == plan.CurrentStage ? "current" : string.Empty)">
                <span class="timeline-dates">@stage.Start.ToString("dd.MM.yyyy") — @stage.End.ToString("dd.MM.yyyy")</span>
                <strong>@stage.Title</strong>
                <span class="muted">@stage.Goal</span>
            </li>
        }
    </ol>

    <h2>Уроки дней 1–10</h2>
    <div class="lesson-list">
        @foreach (var lesson in plan.Lessons)
        {
            <details class="card" open="@(lesson.Day == plan.CurrentDay)">
                <summary><span class="day-number">День @lesson.Day</span> @lesson.Title</summary>
                <ul>
                    @foreach (var point in lesson.KeyPoints)
                    {
                        <li>@point</li>
                    }
                </ul>
            </details>
        }
    </div>
}

@code {
    private PlanDto? _plan;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _plan = await Api.GetPlanAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex.Message;
        }
    }
}
