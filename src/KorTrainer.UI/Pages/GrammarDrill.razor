@page "/grammar/{Type}"
@using KorTrainer.Domain.Grammar
@inherits RuleFirstPageBase

<PageTitle>Грамматика — KorTrainer</PageTitle>

@if (_theory is not null && !Drilling)
{
    <GrammarTheoryView Theory="_theory" Title="@(GrammarCatalog.Find(Type)?.Title ?? Type)" OnStart="StartAsync" CheckHref="@SelfCheckHref" />
}
else
{
    @if (ReadError is not null)
    {
        <p class="notice error small">Не удалось отметить правило прочитанным: @ReadError</p>
    }

    @* The key forces a fresh drill when the topic in the URL changes. *@
    <ChoiceDrill @key="@($"{Type}:{Check}")" Load="LoadAsync" BackHref="/grammar" SelfCheck="Check" SelfCheckHref="@SelfCheckHref" />

    @if (_theory is not null)
    {
        <RuleRecap Steps="_theory.Steps" Pitfall="@_theory.Pitfall" />
    }
}

@code {
    private const int SetSize = 20;
    private const int SelfCheckSize = 10;

    protected override string SelfCheckHref => $"/grammar/{Uri.EscapeDataString(Type)}?drill=true&check=true";

    private GrammarTheory? _theory;

    protected override string Material => StudyMaterials.GrammarRule(Type);

    protected override bool LoadRule()
    {
        _theory = GrammarTheories.Find(Type);
        return _theory is not null;
    }

    private async Task<ExerciseSetDto> LoadAsync()
    {
        await RetryMarkReadAsync();
        return await Api.GetGrammarExercisesAsync(Type, Check ? SelfCheckSize : SetSize);
    }
}
