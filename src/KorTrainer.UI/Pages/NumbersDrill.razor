@page "/numbers/{Type}"
@inject IKorTrainerApi Api

<PageTitle>Числа — KorTrainer</PageTitle>

@* The key forces a fresh drill when the type in the URL changes. *@
<ChoiceDrill @key="Type" Load="LoadAsync" BackHref="/numbers" />

@code {
    private const int SetSize = 20;

    [Parameter]
    public string Type { get; set; } = string.Empty;

    private Task<ExerciseSetDto> LoadAsync() => Api.GetNumberExercisesAsync(Type, SetSize);
}
