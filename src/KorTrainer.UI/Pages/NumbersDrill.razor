@page "/numbers/{Type}"
@using KorTrainer.Domain.Numbers
@inherits RuleFirstPageBase

<PageTitle>Числа — KorTrainer</PageTitle>

@if (_theory is not null && !Drilling)
{
    <NumberTheoryView Theory="_theory" OnStart="StartAsync" CheckHref="@SelfCheckHref" />
}
else
{
    @if (ReadError is not null)
    {
        <p class="notice error small">Не удалось отметить правило прочитанным: @ReadError</p>
    }

    @* The key forces a fresh drill when the type in the URL changes. *@
    <ChoiceDrill @key="@($"{Type}:{Check}")" Load="LoadAsync" BackHref="/numbers" SelfCheck="Check" SelfCheckHref="@SelfCheckHref" />

    @if (_theory is not null)
    {
        <RuleRecap Steps="_theory.Steps" Pitfall="@_theory.Pitfall" />
    }
}

@code {
    private const int SetSize = 20;
    private const int SelfCheckSize = 10;

    protected override string SelfCheckHref => $"/numbers/{Uri.EscapeDataString(Type)}?drill=true&check=true";

    private NumberTheory? _theory;

    protected override string Material => StudyMaterials.NumberRule(Type);

    protected override bool LoadRule()
    {
        _theory = NumberTheories.Find(Type);
        return _theory is not null;
    }

    private async Task<ExerciseSetDto> LoadAsync()
    {
        await RetryMarkReadAsync();
        return await Api.GetNumberExercisesAsync(Type, Check ? SelfCheckSize : SetSize);
    }
}
