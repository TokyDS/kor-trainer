@page "/lesson/{Day:int}"
@inject IKorTrainerApi Api
@inject NavigationManager Navigation

<PageTitle>Конспект урока — KorTrainer</PageTitle>

@if (Roadmap.Lessons.FirstOrDefault(l => l.Day == Day) is not { } lesson)
{
    <p class="notice error">Такого урока в плане нет.</p>
    <a class="btn" href="/">К задачам шага</a>
}
else
{
    <article class="theory">
        <header class="page-header">
            <a class="back" href="/">← К задачам шага</a>
            <p class="eyebrow">Конспект урока @lesson.Day</p>
            <h1>@lesson.Title</h1>
        </header>

        <section class="card theory-steps" aria-label="Главное в уроке">
            <ol>
                @foreach (var point in lesson.KeyPoints)
                {
                    <li>@point</li>
                }
            </ol>
        </section>

        @if (_readError is not null)
        {
            <p class="notice error small">Не удалось отметить конспект прочитанным: @_readError</p>
        }

        <div class="actions">
            <button type="button" class="btn primary" disabled="@_saving" @onclick="FinishAsync">Прочитано — к заданиям</button>
        </div>
    </article>
}

@code {
    private bool _saving;
    private string? _readError;

    [Parameter]
    public int Day { get; set; }

    private async Task FinishAsync()
    {
        _saving = true;
        _readError = null;
        try
        {
            await Api.MarkReadAsync(StudyMaterials.Lesson(Day));
            Navigation.NavigateTo("/");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _readError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
