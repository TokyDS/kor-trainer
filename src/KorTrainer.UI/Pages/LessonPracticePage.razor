@page "/lesson/{Day:int}/practice"
@inject IKorTrainerApi Api
@inject ISpeechInput SpeechInput
@inject NavigationManager Navigation

<PageTitle>Диалог урока — KorTrainer</PageTitle>

@if (LessonPractices.Find(Day) is not { } practice)
{
    <p class="notice error">У этого урока нет диалога.</p>
    <a class="btn" href="/">К задачам шага</a>
}
else
{
    <article class="theory practice">
        <header class="page-header">
            <a class="back" href="/">← К задачам шага</a>
            <p class="eyebrow">Урок @Day · применение</p>
            <h1>Диалог урока</h1>
            <p class="theory-meaning">@practice.Setting</p>
            <p class="muted small">
                Прочитайте каждую реплику, послушайте её и попробуйте понять без перевода. Проговорить и проверить
                себя можно по желанию — урок засчитывается и без этого.
            </p>
            <label class="toggle small"><input type="checkbox" @bind="_showAll" /> Показать все переводы</label>
        </header>

        <ol class="practice-lines">
            @for (int i = 0; i < practice.Lines.Count; i++)
            {
                int index = i;
                var line = practice.Lines[i];
                bool shown = _showAll || _revealed.Contains(index);
                <li class="practice-line @(index > 0 && practice.Lines[index - 1].Speaker == line.Speaker ? "same-speaker" : string.Empty)">
                    <span class="practice-speaker">@line.Speaker</span>
                    <div class="practice-body">
                        <div class="theory-example-line">
                            <span class="theory-sentence" lang="ko">@line.Korean</span>
                            <SpeakButton Text="@line.Korean" ShowKeyHint="false" />
                        </div>
                        @if (shown)
                        {
                            <span class="practice-translation">@line.Russian</span>
                            @if (line.Note is not null)
                            {
                                <span class="theory-derivation">@line.Note</span>
                            }
                        }
                        else
                        {
                            <button type="button" class="link-button small" @onclick="() => _revealed.Add(index)">Перевод</button>
                        }
                        @if (_canListen)
                        {
                            <SpeakCheck Expected="@line.Korean" />
                        }
                    </div>
                </li>
            }
        </ol>

        @if (!_canListen)
        {
            <p class="muted small">Распознавание речи здесь недоступно: проговаривайте вслух без проверки.</p>
        }

        @if (_readError is not null)
        {
            <p class="notice error small">Не удалось отметить диалог: @_readError</p>
        }

        <div class="actions">
            <button type="button" class="btn primary" disabled="@_saving" @onclick="FinishAsync">Готово — к заданиям</button>
        </div>
    </article>
}

@code {
    private readonly HashSet<int> _revealed = [];
    private bool _showAll;
    private bool _canListen;
    private bool _saving;
    private string? _readError;

    [Parameter]
    public int Day { get; set; }

    protected override async Task OnInitializedAsync() => _canListen = await SpeechInput.IsAvailableAsync();

    private async Task FinishAsync()
    {
        _saving = true;
        _readError = null;
        try
        {
            await Api.MarkReadAsync(StudyMaterials.Practice(Day));
            Navigation.NavigateTo("/");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _readError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
