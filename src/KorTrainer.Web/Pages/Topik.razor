@page "/topik"
@inject ApiClient Api

<PageTitle>TOPIK — KorTrainer</PageTitle>

<header class="page-header">
    <h1>Подготовка к TOPIK II: письмо</h1>
    <p class="muted">Секция 쓰기 длится @(_guide?.SectionMinutes ?? 50) минут на четыре задания. Тренируйтесь на официальных прошлых вариантах и пишите ответы здесь на таймере: тренажёр считает знаки как на 원고지 и сохраняет черновики.</p>
    <a class="btn primary" href="@(_guide?.PastPapersUrl ?? "https://www.topik.go.kr/")" target="_blank" rel="noopener noreferrer">Прошлые варианты на topik.go.kr ↗</a>
</header>

<StatusViews IsLoading="_guide is null && _error is null" Error="@_error" OnRetry="LoadAsync" />

@if (_guide is { } guide)
{
    <div class="topik-tasks">
        @foreach (var task in guide.Tasks)
        {
            <section class="card topik-task" aria-labelledby="task-@task.Number">
                <div class="section-head">
                    <h2 id="task-@task.Number">@task.Title</h2>
                    <span class="badge">≈ @task.RecommendedMinutes мин</span>
                </div>
                <p>@task.Format</p>
                <ul class="tips">
                    @foreach (var tip in task.Tips)
                    {
                        <li>@tip</li>
                    }
                </ul>
                <details>
                    <summary>Шаблоны фраз</summary>
                    <dl class="phrases">
                        @foreach (var phrase in task.Template)
                        {
                            <div>
                                <dt>@phrase.Part</dt>
                                <dd><span lang="ko">@phrase.Korean</span><br /><span class="muted">@phrase.Russian</span></dd>
                            </div>
                        }
                    </dl>
                </details>
                <a class="btn" href="/topik/writing?task=@task.Number">Писать на таймере</a>
            </section>
        }
    </div>

    @if (_drafts is { Count: > 0 } drafts)
    {
        <section class="card" aria-labelledby="drafts-heading">
            <h2 id="drafts-heading">Последние черновики</h2>
            <ul class="draft-list">
                @foreach (var draft in drafts)
                {
                    <li>
                        <details>
                            <summary>
                                <strong>№@draft.TaskNumber</strong>
                                <span class="muted">@draft.StartedUtc.ToLocalTime().ToString("dd.MM HH:mm") · @(draft.DurationSeconds / 60) мин · @draft.CharCount знаков</span>
                            </summary>
                            <p class="draft-text" lang="ko">@draft.Text</p>
                        </details>
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    private WritingGuideDto? _guide;
    private IReadOnlyList<WritingDraftDto>? _drafts;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var guide = Api.GetWritingGuideAsync();
            var drafts = Api.GetDraftsAsync();
            _guide = await guide;
            _drafts = await drafts;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex.Message;
        }
    }
}
