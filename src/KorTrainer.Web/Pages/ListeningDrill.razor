@page "/listening/{Type}"
@inject ApiClient Api

<PageTitle>Аудирование — KorTrainer</PageTitle>

@* The key forces a fresh drill when the type in the URL changes. *@
<ChoiceDrill @key="Type" Load="LoadAsync" BackHref="/listening" />

@code {
    private const int SetSize = 20;

    [Parameter]
    public string Type { get; set; } = string.Empty;

    private Task<ExerciseSetDto> LoadAsync() => Api.GetListeningExercisesAsync(Type, SetSize);
}
