@page "/topik/writing"
@using KorTrainer.Domain.Topik
@implements IDisposable
@inject ApiClient Api

<PageTitle>Письмо TOPIK — KorTrainer</PageTitle>

<header class="page-header">
    <a class="back" href="/topik">← TOPIK</a>
    <h1>@(_task?.Title ?? "Письмо")</h1>
</header>

<div class="segmented" role="tablist" aria-label="Задание">
    @foreach (var task in WritingTasks.All)
    {
        int number = task.Number;
        <button type="button" role="tab" aria-selected="@(_task?.Number == number)" class="@(_task?.Number == number ? "active" : string.Empty)"
                disabled="@(_running || IsDirty)" title="@(IsDirty ? "Сначала сохраните черновик" : null)" @onclick="() => SelectTask(number)">
            @number
        </button>
    }
</div>

@if (_task is { } current)
{
    <div class="writing-layout">
        <section class="card writing">
            <p class="muted">@current.Format</p>
            <div class="timer-row">
                <span class="timer @(RemainingSeconds <= 60 && _running ? "urgent" : string.Empty)" aria-live="off">@FormatTime(RemainingSeconds)</span>
                @if (!_running)
                {
                    <button type="button" class="btn primary" @onclick="Start">@(ElapsedSeconds == 0 ? "Старт" : "Продолжить")</button>
                }
                else
                {
                    <button type="button" class="btn" @onclick="Pause">Пауза</button>
                }
                <button type="button" class="btn" disabled="@(_saving || !IsDirty)" @onclick="SaveAsync">Сохранить</button>
            </div>

            <textarea lang="ko" rows="12" maxlength="4000" placeholder="Пишите ответ здесь (стиль -다)…" @bind="Text" @bind:event="oninput" aria-label="Ответ"></textarea>

            <p class="char-count @CountClass">
                Знаков: <strong>@CharCount</strong>
                @if (current.MinChars is { } min && current.MaxChars is { } max)
                {
                    <span> / нужно @min–@max</span>
                }
            </p>
            @if (_message is not null)
            {
                <p class="notice @(_isError ? "error" : "success") small">@_message</p>
            }
        </section>

        <aside class="card">
            <h2>Шаблоны</h2>
            <dl class="phrases">
                @foreach (var phrase in current.Template)
                {
                    <div>
                        <dt>@phrase.Part</dt>
                        <dd><span lang="ko">@phrase.Korean</span><br /><span class="muted">@phrase.Russian</span></dd>
                    </div>
                }
            </dl>
            <ul class="tips">
                @foreach (var tip in current.Tips)
                {
                    <li>@tip</li>
                }
            </ul>
        </aside>
    </div>
}

@code {
    // Elapsed time is measured by a stopwatch, not by counting ticks: background tabs throttle timers.
    private readonly System.Diagnostics.Stopwatch _stopwatch = new();
    private WritingTask? _task;
    private string _text = string.Empty;
    private bool _running;
    private bool _saving;
    private bool _dirty;
    private DateTime _startedUtc;
    private Timer? _timer;
    private string? _message;
    private bool _isError;

    [SupplyParameterFromQuery(Name = "task")]
    public int? TaskNumber { get; set; }

    private string Text
    {
        get => _text;
        set
        {
            _text = value;
            _dirty = true;
        }
    }

    /// <summary>Unsaved timed work or text exists.</summary>
    private bool IsDirty => _dirty || ElapsedSeconds > 0;

    private int ElapsedSeconds => (int)_stopwatch.Elapsed.TotalSeconds;

    private int CharCount => WritingTasks.CountCharacters(_text);

    private int RemainingSeconds => Math.Max(0, ((_task?.RecommendedMinutes ?? 0) * 60) - ElapsedSeconds);

    private string CountClass => _task is { MinChars: { } min, MaxChars: { } max }
        ? CharCount < min ? "under" : CharCount > max ? "over" : "ok"
        : string.Empty;

    protected override void OnInitialized() => SelectTask(TaskNumber ?? 54);

    private void SelectTask(int number)
    {
        _task = WritingTasks.Find(number) ?? WritingTasks.Find(54);
        _text = string.Empty;
        _dirty = false;
        _stopwatch.Reset();
        _message = null;
    }

    private void Start()
    {
        if (ElapsedSeconds == 0)
        {
            _startedUtc = DateTime.UtcNow;
        }

        _running = true;
        _stopwatch.Start();
        _timer ??= new Timer(_ => _ = InvokeAsync(TickAsync), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Pause()
    {
        _running = false;
        _stopwatch.Stop();
    }

    private async Task TickAsync()
    {
        try
        {
            if (_running && RemainingSeconds == 0)
            {
                Pause();
                bool saved = await SaveAsync();
                if (saved)
                {
                    _message = "Время вышло — черновик сохранён. На экзамене на этом месте пришлось бы остановиться.";
                }
            }

            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // The page was closed between ticks.
        }
    }

    private async Task<bool> SaveAsync()
    {
        if (_task is null || _saving)
        {
            return false;
        }

        _saving = true;
        Pause();
        int seconds = ElapsedSeconds;
        try
        {
            var started = seconds == 0 ? DateTime.UtcNow : _startedUtc;
            var draft = await Api.SaveDraftAsync(new SaveDraftRequest(_task.Number, started, seconds, _text));
            (_message, _isError) = ($"Черновик сохранён: {draft.CharCount} знаков за {seconds / 60} мин {seconds % 60} с.", false);

            // The saved time is counted once; continuing starts a new timed attempt.
            _stopwatch.Reset();
            _dirty = false;
            return true;
        }
        catch (Exception ex)
        {
            (_message, _isError) = ($"Не удалось сохранить: {ex.Message}. Скопируйте текст, чтобы не потерять его.", true);
            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatTime(int seconds) => $"{seconds / 60:00}:{seconds % 60:00}";

    public void Dispose() => _timer?.Dispose();
}
