@page "/settings"
@using KorTrainer.Domain.Entities
@inject AppState State
@inject ApiClient Api

<PageTitle>Настройки — KorTrainer</PageTitle>

<header class="page-header">
    <h1>Настройки</h1>
</header>

@if (_model is { } m)
{
    <form class="card settings-form" @onsubmit="SaveAsync">
        <label>
            <span>Дата старта плана</span>
            <input type="date" @bind="m.StartDate" />
            <small class="muted">День 1 — эта дата. Этапы после 10-го дня привязаны к календарю (до 31.12.2026 — этап 1 и т.д.).</small>
        </label>

        <label>
            <span>Часовой пояс</span>
            <select @bind="m.TimeZoneId">
                @foreach (var zone in TimeZones.Append(m.TimeZoneId).Distinct())
                {
                    <option value="@zone">@zone</option>
                }
            </select>
            <small class="muted">Определяет, когда начинается новый учебный день.</small>
        </label>

        <label class="toggle">
            <input type="checkbox" @bind="m.ShowRomanization" />
            <span>Показывать латиницу (романизацию)</span>
        </label>
        <small class="muted">По умолчанию выключено: так быстрее привыкаешь читать хангыль без подсказок.</small>

        <label>
            <span>Тема</span>
            <select @bind="m.Theme">
                <option value="@ThemePreference.System">Как в системе</option>
                <option value="@ThemePreference.Light">Светлая</option>
                <option value="@ThemePreference.Dark">Тёмная</option>
            </select>
        </label>

        <div class="two-columns">
            <label>
                <span>Новых слов в день</span>
                <input type="number" min="1" max="100" @bind="m.NewWordsPerDay" />
            </label>
            <label>
                <span>Максимум повторений в день</span>
                <input type="number" min="10" max="5000" @bind="m.MaxReviewsPerDay" />
            </label>
        </div>

        <label>
            <span>Скорость речи: @m.SpeechRate.ToString("0.0#")</span>
            <input type="range" min="0.5" max="1.5" step="0.05" @bind="m.SpeechRate" @bind:event="oninput" />
        </label>

        <div class="actions">
            <button type="submit" class="btn primary" disabled="@_saving">Сохранить</button>
            <button type="button" class="btn" @onclick="TestVoiceAsync">Проверить голос: 안녕하세요</button>
        </div>
        @if (_message is not null)
        {
            <p class="notice @(_isError ? "error" : "success") small">@_message</p>
        }
    </form>

    <section class="card">
        <h2>Озвучка</h2>
        @if (State.Speech is { HasKoreanVoice: true } speech)
        {
            <p>Найден корейский голос: <strong>@speech.VoiceName</strong>.</p>
        }
        <VoiceNotice />
    </section>

    <section class="card">
        <h2>Резервная копия прогресса</h2>
        <p class="muted">Экспорт сохраняет повторения слов, ответы, сессии и настройки в JSON-файл. Импорт полностью заменяет текущий прогресс.</p>
        <div class="actions">
            <a class="btn" href="api/progress/export" download>Скачать JSON</a>
        </div>
        <label class="toggle">
            <input type="checkbox" @bind="_confirmImport" />
            <span>Я понимаю, что текущий прогресс будет заменён</span>
        </label>
        <InputFile OnChange="ImportAsync" accept="application/json,.json" disabled="@(!_confirmImport || _importing)" />
        @if (_importMessage is not null)
        {
            <p class="notice @(_importError ? "error" : "success") small">@_importMessage</p>
        }
    </section>
}

@code {
    private const long MaxImportBytes = 20 * 1024 * 1024;

    private static readonly string[] TimeZones =
    [
        "Europe/Kaliningrad", "Europe/Moscow", "Europe/Samara", "Asia/Yekaterinburg", "Asia/Omsk",
        "Asia/Novosibirsk", "Asia/Krasnoyarsk", "Asia/Irkutsk", "Asia/Yakutsk", "Asia/Vladivostok",
        "Asia/Seoul", "Europe/Minsk", "Asia/Almaty", "Asia/Tashkent", "UTC",
    ];

    private SettingsModel? _model;
    private bool _saving;
    private bool _isError;
    private string? _message;
    private bool _confirmImport;
    private bool _importing;
    private bool _importError;
    private string? _importMessage;

    protected override async Task OnInitializedAsync()
    {
        await State.InitializeAsync();
        _model = SettingsModel.From(State.Settings);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _saving = true;
        try
        {
            await State.SaveSettingsAsync(_model.ToDto());
            _model = SettingsModel.From(State.Settings);
            (_message, _isError) = ("Сохранено.", false);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            (_message, _isError) = (ex.Message, true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestVoiceAsync() =>
        await State.SpeakAsync("안녕하세요");

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        _importing = true;
        _importMessage = null;
        try
        {
            await using var stream = e.File.OpenReadStream(MaxImportBytes);
            var result = await Api.ImportProgressAsync(stream, CancellationToken.None);
            _importError = false;
            _importMessage = $"Импортировано: слов {result.Words} (пропущено {result.SkippedWords}), повторений {result.Reviews}, ответов {result.Attempts}, сессий {result.Sessions}.";
            _confirmImport = false;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or IOException)
        {
            _importError = true;
            _importMessage = ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    /// <summary>Mutable form model; the settings DTO itself is immutable.</summary>
    private sealed class SettingsModel
    {
        public DateOnly StartDate { get; set; }

        public string TimeZoneId { get; set; } = string.Empty;

        public bool ShowRomanization { get; set; }

        public ThemePreference Theme { get; set; }

        public int NewWordsPerDay { get; set; }

        public int MaxReviewsPerDay { get; set; }

        public double SpeechRate { get; set; }

        public static SettingsModel From(SettingsDto s) => new()
        {
            StartDate = s.StartDate,
            TimeZoneId = s.TimeZoneId,
            ShowRomanization = s.ShowRomanization,
            Theme = s.Theme,
            NewWordsPerDay = s.NewWordsPerDay,
            MaxReviewsPerDay = s.MaxReviewsPerDay,
            SpeechRate = s.SpeechRate,
        };

        public SettingsDto ToDto() =>
            new(StartDate, TimeZoneId, ShowRomanization, Theme, NewWordsPerDay, MaxReviewsPerDay, SpeechRate);
    }
}
