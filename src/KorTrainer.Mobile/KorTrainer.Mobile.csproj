<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Android app: the shared Blazor pages in a BlazorWebView over the in-process back end (no server needed). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <RootNamespace>KorTrainer.Mobile</RootNamespace>

    <ApplicationTitle>KorTrainer</ApplicationTitle>
    <ApplicationId>com.tokyds.kortrainer</ApplicationId>
    <ApplicationDisplayVersion>3.4</ApplicationDisplayVersion>
    <ApplicationVersion>25</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- A plain APK to install directly (Google Play would want an .aab). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Release: phones only (arm64; the x86_64 emulator libraries add ~34 MB) and v2/v3 signing only — the v1 jar
       signature would list every one of the ~29,000 speech files twice. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidApkSignerAdditionalArguments>--v1-signing-enabled false</AndroidApkSignerAdditionalArguments>
  </PropertyGroup>

  <!-- Release signing: the keystore lives outside the repository (see README "Android app"). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(KorTrainerKeystore)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(KorTrainerKeystore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>kortrainer</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:KORTRAINER_KEYSTORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:KORTRAINER_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#C0392F" BaseSize="108,108" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#C0392F" BaseSize="128,128" />
    <!-- Neural speech from tools/tts/generate_edge.py or generate_melo.py, packed for the phone by tools/android/pack_speech.py
         (build-apk.sh runs it); optional — without it the system voice is used. -->
    <MauiAsset Include="..\..\artifacts\tts\apk-speech\*.opus;..\..\artifacts\tts\apk-speech\manifest.json" LogicalName="tts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KorTrainer.Embedded\KorTrainer.Embedded.csproj" />
  </ItemGroup>

</Project>
